################################################################################
## Electrolyte Effects — adapted for re_05system1M (3-layer carbon)          ##
## Based on: mix-0.55-wig-1.5/lmp.in                                         ##
################################################################################

variable	thermo_step	equal	1000
variable	sp_run_step	equal	1000000
variable	ad_up_force	equal	0.01873
variable	ad_dn_force	equal	0.00003764

variable    v_element  string   "cp c up_c O H o h Na Cl"   # 按Masses顺序: type1-9

# ==============================================================================
# Model settings
# ==============================================================================

units           real
boundary        p p p
atom_style      full

read_data	re_05system1M.data

pair_style      lj/cut/coul/long 10.0 10.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none
kspace_style    pppm 1.0e-4

# =================== Partial_Charge ======================

set	type	1	charge	   0.0      # cp  (底电极)
set	type	2	charge     0.0	    # c   (中间摆动膜)
set	type	3	charge     0.0	    # up_c(顶电极)
set	type	4	charge    -0.8476	# O   (纯水)
set	type	5	charge     0.4238	# H   (纯水)
set	type	6	charge    -0.8476	# o   (海水)
set	type	7	charge     0.4238	# h   (海水)
set	type	8	charge     1.00 	# Na
set	type	9	charge    -1.00	    # Cl

# ==============================================================================
# Force field settings
# ==============================================================================

pair_coeff   1 1    0.10500000    3.85100000   # cp
pair_coeff   2 2    0.10500000    3.85100000   # c
pair_coeff   3 3    0.10500000    3.85100000   # up_c
pair_coeff   4 4    0.15440000    3.16550000   # O  (纯水)
pair_coeff   5 5    0.00000000    0.00000000   # H  (纯水)
pair_coeff   6 6    0.15440000    3.16550000   # o  (海水)
pair_coeff   7 7    0.00000000    0.00000000   # h  (海水)
pair_coeff   8 8    0.12000000    3.29630000   # Na
pair_coeff   9 9    0.10000000    4.40000000   # Cl

pair_modify     mix arithmetic

# Bond Coeffs # harmonic

bond_coeff    1   480.0000    1.3400  # cp-cp
bond_coeff    2   480.0000    1.3400  # c-c
bond_coeff    3   480.0000    1.3400  # up_c-up_c
bond_coeff    4   554.1350	  1.0000  # O-H  (纯水)
bond_coeff    5   554.1350	  1.0000  # o-h  (海水)

# Angle Coeffs # harmonic

angle_coeff   1   90.0000   120.0000  # cp-cp-cp
angle_coeff   2   90.0000   120.0000  # c-c-c
angle_coeff   3   90.0000   120.0000  # up_c-up_c-up_c
angle_coeff   4   45.7696   109.4700  # H-O-H  (纯水)
angle_coeff   5   45.7696   109.4700  # h-o-h  (海水)

# ==============================================================================
# Group settings
# ==============================================================================

# --- 碳层 group (沿用示例命名，按新系统物理角色重映射) ---
group 	  cp         type 1     # cp  = 底部刚性对电极 (示例是type2)
group 	  cof        type 2     # cof = 中间摆动工作电极 (示例是type1)
group 	  up_cp      type 3     # up_cp = 顶部刚性对电极 (与示例一致)

# --- 纯水 group (type4=O, type5=H) ---
group 	  O          type 4
group 	  H          type 5
group 	  h2o        type 4 5

# --- 海水 group (type6=o, type7=h) ---
group 	  o          type 6
group 	  water      type 6 7

# --- 离子 group ---
group 	  na         type 8
group 	  cl         type 9

# --- 组合 group ---
group 	  aqu        type 8 9 6 7     # Na+Cl+海水 = 上部盐水+离子
group 	  aqueous    type 4 5 6 7 8 9 # 全部水+离子

# ==============================================================================
# Region settings (Z坐标基于 re_05system1M 几何)
# ==============================================================================

# 底部区域: 底电极(cp@198) + 纯水(Z=204-297)
region	  r_bottom	block  INF INF INF INF  1.0    300.0

# 中间摆动膜区域: c @ Z=301-318
region	  r_up_cp   block  INF INF INF INF  299.0  320.0

# 上部区域: 海水(Z=322-415) + 顶电极(up_c@421)
region	  r_up      block  INF INF INF INF  318.0  425.0

# ==============================================================================
# water flux
# ==============================================================================

group	 r_bottom_o 	dynamic  o   region  r_bottom  every 1
group	 r_bottom_na 	dynamic  na  region  r_bottom  every 1
group	 r_bottom_cl 	dynamic  cl  region  r_bottom  every 1
group	 r_up_O 	    dynamic  O   region  r_up      every 1

variable	n_bottom_o	  equal	 count(r_bottom_o)
variable	n_bottom_na	  equal	 count(r_bottom_na)
variable	n_bottom_cl	  equal	 count(r_bottom_cl)
variable	n_up_O	      equal	 count(r_up_O)

variable   net_o   equal  v_n_bottom_o-v_n_up_O 

# ==============================================================================
# Neighbor settings
# ==============================================================================

neighbor        2.0  bin
neigh_modify    delay  5  one  5000
neigh_modify    exclude  group   cof  cof
neigh_modify    exclude  group   cp  cp
neigh_modify    exclude  group   up_cp  up_cp

# ==============================================================================
# Compute settings
# ==============================================================================

compute   Taqu  aqu   temp

# ==============================================================================
# Thermo style settings
# ==============================================================================

thermo_style	custom step cpu cpuremain temp c_Taqu v_n_bottom_o v_n_bottom_na v_n_bottom_cl v_n_up_O etotal ke pe evdwl ecoul elong ebond eangle
thermo          ${thermo_step}

thermo_modify   lost  ignore flush yes

fix   1   all  ave/time  100  1  100  v_net_o  v_n_bottom_o  v_n_bottom_na  v_n_bottom_cl  v_n_up_O  file  tube_re05_1M.dat 

fix	  m1   cof  move  wiggle 0.0 1.5 0.0 1000.0 units box

# ==============================================================================
# water number density
# ============================================================================== 

compute  n_z_o    o   chunk/atom bin/1d z lower 0.1
compute  n_z_na   na  chunk/atom bin/1d z lower 0.1 
compute  n_z_cl   cl  chunk/atom bin/1d z lower 0.1 
compute  n_z_O    O   chunk/atom bin/1d z lower 0.1
 
compute  n_x_o    o   chunk/atom bin/1d x lower 0.1
compute  n_x_na   na  chunk/atom bin/1d x lower 0.1 
compute  n_x_cl   cl  chunk/atom bin/1d x lower 0.1 
compute  n_x_O    O   chunk/atom bin/1d x lower 0.1 

fix  n_z_o   o   ave/chunk 100 100 10000  n_z_o   density/number  file  num_z_o.dat
fix  n_z_na  na  ave/chunk 100 100 10000  n_z_na  density/number  file  num_z_na.dat
fix  n_z_cl  cl  ave/chunk 100 100 10000  n_z_cl  density/number  file  num_z_cl.dat
fix  n_z_O   O   ave/chunk 100 100 10000  n_z_O   density/number  file  num_z_O.dat 
															 	 
fix  n_x_o   o   ave/chunk 100 100 10000  n_x_o   density/number  file  num_x_o.dat  
fix  n_x_na  na  ave/chunk 100 100 10000  n_x_na  density/number  file  num_x_na.dat
fix  n_x_cl  cl  ave/chunk 100 100 10000  n_x_cl  density/number  file  num_x_cl.dat
fix  n_x_O   O   ave/chunk 100 100 10000  n_x_O   density/number  file  num_x_O.dat  

compute	  na  na	 msd
compute	  cl  cl	 msd
		  
compute	  1	   all   rdf 100  6  8  6  9 

fix	  cl   cl	 ave/time 100 1 100 c_cl[1]  c_cl[2]  c_cl[3]  c_cl[4]  file  msd_cl.dat  title1 "t msd msd msd msd_Cl"	title2 "fs A2 A2 A2 A2"
fix	  na   na	 ave/time 100 1 100 c_na[1]  c_na[2]  c_na[3]  c_na[4]  file  msd_na.dat  title1 "t msd msd msd msd_Na"	title2 "fs A2 A2 A2 A2"
		  
fix	  rdf  all	 ave/time 100 1 100 c_1[*] file rdf.dat mode vector

# =================== Dump settings ===========================

write_data	relax.*.data	nocoeff
write_dump	all	custom	relax.*.lammpstrj id element x y z q modify element ${v_element} sort id

dump		 trj_h2o   h2o  custom  10000  h2o.lammpstrj id element x y z q 
dump_modify	 trj_h2o   flush  yes	element ${v_element} sort id

dump		 trj_water   water  custom  10000  water.lammpstrj id element x y z q 
dump_modify	 trj_water   flush  yes	element ${v_element} sort id

dump		 strj1	 all	custom	10000  all.lammpstrj id element x y z q 
dump_modify	 strj1	 flush	yes	element ${v_element}

# =================== Sampling run ============================

velocity			up_cp	set 0.0 0.0 0.0
fix		addf_up 	up_cp	addforce 0 0 $(-v_ad_up_force)

velocity			cp  	set 0.0 0.0 0.0
fix		addf_down	cp	    addforce 0 0 $(v_ad_dn_force)
 
# ====================== Neutral =============================

fix	   f_up_cp	up_cp	rigid/nvt group 1 up_cp temp 300.0 300.0 100.0  torque * off off off
fix	   f_cp	     cp	    rigid/nvt group 1 cp    temp 300.0 300.0 100.0  torque * off off off

fix	   3	aqueous	nvt temp  300.0 300.0 100.0
timestep    1.0
run	   ${sp_run_step}
unfix  3

write_data	re05-1M-total.data
