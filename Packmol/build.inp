################################################################################
##  Packmol 输入: 石墨烯-CNT膜-石墨烯 | 纯水 vs 0.5M NaCl                     ##
##  rePackmol — PBC安全版 (XY内缩1.5Å)                                       ##
################################################################################

tolerance       2.2
filetype        pdb
output          re_system.pdb
resnumbers      2

# ==============================================================================
# 固体骨架: 石墨烯下层 + CNT膜 + 石墨烯上层 (固定)
# ==============================================================================
structure smx_0.5cnt_smx.pdb
  number 1
  fixed 0. 0. 0. 0. 0. 0.
end structure

# ==============================================================================
# 真空1: 纯水 (Z: 201.7~297.1, XY: 1.5~98.5, margin=4Å)
# ==============================================================================
structure water1.pdb
  number 12100
  inside box 1.5 1.5 201.7  98.5 98.5 297.1
end structure

# ==============================================================================
# 真空2: 1.0M NaCl 溶液 (Z: 321.9~417.3, XY: 1.5~98.5, margin=4Å)
# ==============================================================================
structure water2.pdb
  number 12100
  inside box 1.5 1.5 321.9  98.5 98.5 417.3
end structure

structure Na.pdb
  number 541
  inside box 1.5 1.5 321.9  98.5 98.5 417.3
end structure

structure Cl.pdb
  number 541
  inside box 1.5 1.5 321.9  98.5 98.5 417.3
end structure
